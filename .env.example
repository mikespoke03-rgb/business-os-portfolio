# Copy to .env and fill in. Never commit .env.
# --- Postgres / Neon (the demo needs only this one) ---
DATABASE_URL=postgresql://demo@localhost:5432/bos_portfolio_demo
# password: put it in PGPASSWORD (libpq reads it) rather than in the URL
PGPASSWORD=REPLACE_ME

# --- n8n public API (backup / rollback scripts) ---
N8N_BASE_URL=https://YOUR-N8N-INSTANCE/api/v1
N8N_API_KEY=REPLACE_ME

# --- Ozon Seller API (configure as an n8n "Header Auth"/custom credential, not here, in production) ---
OZON_CLIENT_ID=REPLACE_ME
OZON_API_KEY=REPLACE_ME

# --- Ozon Performance API (ads) ---
OZON_PERFORMANCE_CLIENT_ID=REPLACE_ME
OZON_PERFORMANCE_CLIENT_SECRET=REPLACE_ME
PPO_CAMPAIGN_ID=REPLACE_ME

# --- Telegram (daily report) ---
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# Owner Q&A needs no model key: the AI layer is the owner's Grok Bot desktop assistant (connected to Neon and n8n).
# Answers are recorded and gated by llm/eval.js; see docs/llm-eval.md.
